# ---------------------------------------------------------------
# CHER server configuration.  Copy to `.env` and fill in the blanks.
# `.env` is gitignored. NEVER commit real credentials.
# ---------------------------------------------------------------
PORT=3000

REDIS_URL=redis://localhost:6379

# --- OpenAI (Agents SDK). Leave blank to run on deterministic fallback only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CHER_AI_TIMEOUT_MS=6000
# Fail-fast breaker: after an AI failure skip the AI (deterministic rules) for this long, so a dead AI never delays contacting anyone.
CHER_AI_BREAKER_SECONDS=60
CHER_AI_QUOTA_BREAKER_SECONDS=900   # no credits / bad key

# --- Twilio. Leave blank to run in SIMULATED mode (no real calls/SMS).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Emergency contacts (E.164, e.g. +15551234567). Contact 1 is required for real calls.
EMERGENCY_CONTACT_1=
EMERGENCY_CONTACT_1_NAME=Emergency Contact 1
EMERGENCY_CONTACT_2=
EMERGENCY_CONTACT_2_NAME=Emergency Contact 2
EMERGENCY_CONTACT_3=
EMERGENCY_CONTACT_3_NAME=Emergency Contact 3

TWILIO_MAX_RETRIES=3
TWILIO_RETRY_INTERVAL_SECONDS=120

# Set true to keep Twilio credentials but never place real calls/SMS (offline demos).
CHER_TWILIO_SIMULATE=false

# TRIAL ACCOUNTS ONLY: Twilio trial rejects a custom webhook `url`, inline TwiML and TwiML Apps on outbound calls
# (verified: HTTP 400 "trial accounts have limited parameter access"). Create three TwiML Bins with
# `npm run twilio:bins` and paste their URLs here. Leave blank on a paid account.
TWILIO_TWIML_BIN_INITIAL=
TWILIO_TWIML_BIN_FOLLOWUP_STATUS=
TWILIO_TWIML_BIN_FOLLOWUP_CONFIRM=

# Public HTTPS base URL that Twilio can reach (e.g. an ngrok/cloudflared tunnel to this server).
# Required for real calls: Twilio fetches TwiML from <CHER_PUBLIC_URL>/twilio/*.
CHER_PUBLIC_URL=

# --- Follow-up policy
CHER_FOLLOWUP_INTERVAL_SECONDS=120
CHER_FOLLOWUP_MAX_RETRIES=3

# --- Demo timing (ONLY used while CHER_DEMO_MODE=true; production uses the normal intervals above)
CHER_DEMO_CALL_INTERVAL_SECONDS=20
CHER_DEMO_OUTREACH_TIMEOUT_SECONDS=45

# DEMO ONLY, default off. With demo mode + real Twilio, an ANSWERED call (Twilio status in-progress) is auto-accepted and
# walked through clearly-labelled "(simulated demo step)" moving/reached steps. Nobody is ever auto-confirmed as helped and
# the emergency is never auto-resolved. It does not verify that any keypress or spoken script happened.
CHER_DEMO_AUTO_ANSWER=false

# --- Nearby CHER watch users are alerted (pop-up with location) BEFORE the external contact is called.
# In demo mode the wait below is replaced by CHER_DEMO_CALL_INTERVAL_SECONDS.
CHER_NEARBY_ENABLED=true
CHER_NEARBY_RADIUS_M=1500
CHER_NEARBY_WAIT_SECONDS=45
CHER_NEARBY_MAX_ALERTED=5                 # how many nearby watches get the pop-up
CHER_NEARBY_MAX_RESPONDERS=2             # how many can be assigned
CHER_NEARBY_LOCATION_MAX_AGE_SECONDS=600 # ignore watches whose last location is older than this
CHER_NEARBY_CHECKIN_SECONDS=60           # follow-up prompt interval for a nearby helper (demo mode: 20 s gap)

# --- Watch / person
CHER_USER_NAME=the CHER user
CHER_WATCH_ID=watch-1

# Optional device token. If set, REST and Socket.IO clients must present it.
# (A prototype convenience, not a secret once compiled into an APK.)
CHER_API_KEY=

# Optional plain-link template for SMS. No map SDK is used. Example: https://example.org/?q={lat},{lng}
CHER_LOCATION_URL_TEMPLATE=

# What the watch app uses for the backend (10.0.2.2 = host machine from the Android emulator).
CHER_SERVER_URL=http://10.0.2.2:3000

# Demo mode enables /api/demo/* routes and accepts unsigned Twilio webhooks when no auth token is set.
CHER_DEMO_MODE=true

LOG_LEVEL=info
