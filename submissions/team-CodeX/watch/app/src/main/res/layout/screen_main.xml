<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenMain"
    style="@style/CherScreen">

    <ScrollView
        android:id="@+id/mainScroll"
        style="@style/CherScroll">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Page 1: status + SOS. Its height is set to the screen height in code. -->
            <FrameLayout
                android:id="@+id/mainPage1"
                android:layout_width="match_parent"
                android:layout_height="480px">

                <com.cher.watch.ui.widgets.RingView
                    android:id="@+id/ringMain"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="24dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingBottom="3dp"
                        android:paddingLeft="9dp"
                        android:paddingRight="10dp"
                        android:paddingTop="3dp">

                        <View
                            android:id="@+id/dotMonitoring"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:background="@drawable/dot" />

                        <TextView
                            android:id="@+id/tvMonitoring"
                            style="@style/CherCaps"
                            android:layout_marginLeft="6dp"
                            android:text="Monitoring"
                            android:textColor="@color/cher_text" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDemoBadge"
                        style="@style/CherCaps"
                        android:layout_marginTop="2dp"
                        android:text="DEMO MODE"
                        android:textColor="@color/cher_amber"
                        android:textSize="8sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.cher.watch.ui.widgets.HeartbeatView
                            android:id="@+id/heartView"
                            android:layout_width="30dp"
                            android:layout_height="30dp" />

                        <TextView
                            android:id="@+id/tvHeart"
                            style="@style/CherBig"
                            android:layout_marginLeft="4dp"
                            android:text="--"
                            android:textSize="52sp" />

                        <TextView
                            style="@style/CherCaps"
                            android:layout_marginLeft="3dp"
                            android:layout_marginTop="20dp"
                            android:text="BPM"
                            android:textColor="@color/cher_text_dim"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvMonitoringDetail"
                        style="@style/CherLabel"
                        android:clickable="true"
                        android:layout_marginLeft="42dp"
                        android:layout_marginRight="42dp"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="2"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:id="@+id/chipRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View android:id="@+id/dotLink" android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/dot" />
                        <TextView android:id="@+id/tvLink" style="@style/CherCaps" android:layout_marginLeft="4dp" android:text="LINK" android:textColor="@color/cher_text_dim" android:textSize="9sp" />
                        <View android:id="@+id/dotGps" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginLeft="10dp" android:background="@drawable/dot" />
                        <TextView android:id="@+id/tvGps" style="@style/CherCaps" android:layout_marginLeft="4dp" android:text="GPS" android:textColor="@color/cher_text_dim" android:textSize="9sp" />
                        <View android:id="@+id/dotBat" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginLeft="10dp" android:background="@drawable/dot" />
                        <TextView android:id="@+id/tvBat" style="@style/CherCaps" android:layout_marginLeft="4dp" android:text="100%" android:textColor="@color/cher_text_dim" android:textSize="9sp" />
                    </LinearLayout>

                    <com.cher.watch.ui.emergency.HoldButton
                        android:id="@+id/btnSos"
                        style="@style/CherButton"
                        android:layout_width="152dp"
                        android:layout_height="44dp"
                        android:layout_marginTop="9dp"
                        android:background="@drawable/bg_button_red"
                        android:text="@string/hold_for_sos"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnMore"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="6dp"
                    android:alpha="0.45"
                    android:contentDescription="More"
                    android:src="@drawable/ic_chevron_down" />
            </FrameLayout>

            <!-- Page 2: details, nearby-help switch, settings -->
            <LinearLayout
                android:id="@+id/mainPage2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="46dp"
                android:paddingLeft="30dp"
                android:paddingRight="30dp"
                android:paddingTop="34dp">

                <TextView style="@style/CherCaps" android:text="Status" android:textColor="@color/cher_text_dim" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingBottom="7dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="7dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView style="@style/CherLabel" android:layout_width="0dp" android:layout_weight="1" android:text="Connection" />
                        <TextView android:id="@+id/tvConnection" style="@style/CherValue" android:textSize="11sp" android:text="CONNECTING" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
                        <TextView style="@style/CherLabel" android:layout_width="0dp" android:layout_weight="1" android:text="Location" />
                        <TextView android:id="@+id/tvLocation" style="@style/CherValue" android:textSize="11sp" android:text="UNAVAILABLE" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
                        <TextView style="@style/CherLabel" android:layout_width="0dp" android:layout_weight="1" android:text="Battery" />
                        <TextView android:id="@+id/tvBattery" style="@style/CherValue" android:textSize="11sp" android:text="100%" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
                        <TextView style="@style/CherLabel" android:layout_width="0dp" android:layout_weight="1" android:text="Heart" />
                        <TextView android:id="@+id/tvHeartNote" style="@style/CherValue" android:ellipsize="end" android:maxLines="1" android:maxWidth="110dp" android:textSize="10sp" android:text="--" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="7dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="8dp"
                    android:paddingTop="7dp">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/CherValue" android:textSize="12sp" android:text="Nearby help" />
                        <TextView android:id="@+id/tvNearbyNote" style="@style/CherLabel" android:textSize="9sp" android:text="Alert me when someone close needs help" />
                    </LinearLayout>
                    <Switch android:id="@+id/swNearby" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNote"
                    style="@style/CherLabel"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:textColor="@color/cher_amber"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnSettings"
                    style="@style/CherButton"
                    android:layout_marginTop="10dp"
                    android:text="@string/settings" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
