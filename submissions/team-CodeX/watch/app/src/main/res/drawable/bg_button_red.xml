<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#D8352B" android:endColor="#A82820" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FF6259" android:endColor="#E23A2F" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</selector>
